#Конфигурация .pfx сертификата
#Директория на хосте, в которой расположен .pfx файл (например, "/etc/certificates/").
PFX_File_Path=<insert directory here>
#Имя файла сертификата, с расширением (например, "certificate.pfx")
PFX_File_Name=<insert filename here>
#Пароль .pfx-файла
PFX_File_Password=<insert pasword here>

#Конфигурация PostgreSQL. Можно оставить значения по умолчанию.
Postgres_Data_Location="/var/postgres_kombinator/data/"
Postgres_User="postgres"
Postgres_User_Password="1qaz2wsx"
